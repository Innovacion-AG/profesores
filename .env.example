# Variables opcionales de scripts/construir.py. Ninguna es secreta.
# El script no lee un archivo .env: se exportan en la terminal antes de
# ejecutarlo, por ejemplo:
#   IDS_PUBLICADOS_URL=https://innovacion-ag.github.io/profesores/ids-publicados.json python3 scripts/construir.py --validar
# En GitHub Actions las define .github/workflows/publicar.yml.

# Dirección de ids-publicados.json para comparar contra el sitio en línea; fuera de Actions, sin ella no se compara.
IDS_PUBLICADOS_URL=
# Referencia de git contra la que se buscan agentes borrados o keys cambiadas (por omisión, HEAD).
COMPARAR_CON=
# Con 1, un agente quitado de agentes.json a propósito ya no detiene la construcción.
PERMITIR_BORRAR=
# Commit que se anota en lista.html e ids-publicados.json; GitHub Actions lo define solo.
GITHUB_SHA=
# Con true, activa la comparación contra el sitio publicado; GitHub Actions lo define solo.
GITHUB_ACTIONS=
